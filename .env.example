# ---------------------------------------------------------------------------
# .env.example (raíz)  —  variables usadas SOLO por docker-compose.yml
# ---------------------------------------------------------------------------
# Copiar a ".env" si se desea cambiar los valores por defecto del contenedor.
# Estos valores son de DESARROLLO LOCAL, no son secretos reales.
# No subir nunca el archivo ".env" con credenciales reales.

# Credenciales del contenedor PostgreSQL (docker-compose.yml)
POSTGRES_USER=minisuper
POSTGRES_PASSWORD=minisuper
POSTGRES_DB=minisuper
POSTGRES_PORT=5432
