// =============================================================================
// SC702-G4-MiniSuper — Esquema Prisma (PostgreSQL)
// =============================================================================
// Diseño del dominio para las 30 historias de usuario (HU-01 … HU-30).
//
// Convenciones de este esquema:
//   * IDs UUID en todas las entidades.
//   * Dinero SIEMPRE con Decimal(12, 2). Nunca Float (HU-17 … HU-30).
//   * Nombres de tabla/columna = los que genera Prisma por defecto (legibilidad).
//   * La cadena de conexión NO vive aquí: Prisma 7 la lee de prisma7.config.ts.
//   * Bajas lógicas (isActive) en lugar de borrado físico, para no romper el
//     historial de ventas (HU-03).
//   * Las alertas y el saldo de fiado NO se almacenan: se derivan (ver
//     docs/ARCHITECTURE.md, "Decisiones de modelado").
// =============================================================================

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Roles fijos. Administrador: la plataforma (negocios, planes y solicitudes;
/// no ve los datos internos de los negocios). Encargado: dueño de un negocio.
/// Cajero: ventas, clientes y fiado. Bodega: inventario, Kardex y pedidos.
enum UserRole {
  ADMIN
  ENCARGADO
  CAJERO
  BODEGA
}

/// Color principal de la interfaz que elige cada usuario. Son opciones ya
/// probadas para que el texto siempre se lea bien sobre ellas.
enum AccentColor {
  /// Diseño neutro del sistema (predeterminado).
  NEUTRO
  AZUL
  VERDE
  MORADO
  NARANJA
  GRIS
}

/// Tamaño del texto que elige cada usuario.
enum FontScale {
  NORMAL
  GRANDE
}

/// Estado de un negocio. Suspendido: nadie de ese negocio entra, pero sus
/// datos se conservan (y vuelven a estar disponibles al reactivarlo).
enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

/// Estado de una solicitud de ampliación del plan.
enum PlanRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Unidad de medida del producto: en qué se cuenta su stock y se vende.
enum UnitOfMeasure {
  UD /// unidad
  KG /// kilogramo
  G /// gramo
  L /// litro
  ML /// mililitro
  M /// metro
  CJ /// caja
  PQ /// paquete
}

/// Tipo de cambio de inventario. Toda variación de stock deja un registro.
/// ADJUSTMENT cubre los conteos físicos (HU-10) y las correcciones.
enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

/// Método de pago de una venta (HU-17: tarjeta o efectivo; HU-18: fiado).
enum PaymentMethod {
  CASH
  CARD
  CREDIT
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOID
}

enum SaleAdjustmentType {
  RETURN
  VOID
}

/// Ciclo de vida de un pedido a proveedor (HU-22: historial de pedidos y
/// entregas). Se mantienen solo los estados que piden las historias: un pedido
/// se registra y se recibe.
enum PurchaseOrderStatus {
  PENDING
  /// Llegó una parte (HU-38): el pedido sigue abierto hasta recibirlo todo o
  /// darlo por concluido.
  PARTIAL
  RECEIVED
}

// -----------------------------------------------------------------------------
// Módulo 2 — Acceso y usuarios (HU-11 … HU-15)
// -----------------------------------------------------------------------------

/// Usuario del sistema con su rol (HU-11 … HU-15). No hay registro público: el
/// administrador inicial se crea con `npm run db:seed` y él crea a los demás.
/// Los administradores son de la plataforma (`businessId` nulo); todos los
/// demás pertenecen a un negocio (lo garantiza un CHECK en la base).
model User {
  id                   String    @id @default(uuid()) @db.Uuid
  businessId           String?   @db.Uuid
  name                 String
  /// Con qué entra al sistema (HU-11): único en toda la plataforma, sin `@`.
  /// Se genera del nombre (`jnavarro`) y se puede cambiar; ver `utils/username.ts`.
  username             String    @unique
  /// Correo para entrar y recuperar la contraseña. Obligatorio para los roles
  /// que recuperan por correo (`ROLE_RECOVERY`); opcional para el personal.
  email                String?   @unique
  /// Nunca en texto plano: se guarda el hash (HU-12).
  passwordHash         String
  /// Qué módulos puede usar (HU-12, criterios de usuarios y roles). Los
  /// permisos de cada rol se definen en `src/auth/permissions.ts`.
  role                 UserRole
  /// Los usuarios no se borran: se desactivan para conservar el historial.
  /// Uno inactivo no puede iniciar sesión.
  isActive             Boolean   @default(true)
  /// `true` con una contraseña temporal (la inicial o una restablecida por el
  /// administrador): hasta cambiarla, la API solo permite cambiar la contraseña.
  mustChangePassword   Boolean   @default(false)
  /// Se incrementa al cerrar sesión (HU-15): todo token emitido con una versión
  /// anterior deja de ser válido, aunque alguien conserve una copia.
  sessionVersion       Int       @default(0)
  /// Recuperación de contraseña por correo (HU-13): el HASH SHA-256 del token
  /// del enlace (nunca el token), y hasta cuándo sirve. Se borra al usarse.
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  preferences     UserPreferences?
  planRequests    PlanRequest[]    @relation("PlanRequestAuthor")
  decidedRequests PlanRequest[]    @relation("PlanRequestDecider")
  accessEvents    AccessEvent[]    @relation("AccessEventUser")
  accessActions   AccessEvent[]    @relation("AccessEventActor")

  @@index([businessId])
}

/// Apariencia que elige cada usuario para sí mismo (Configuración ›
/// Apariencia). Va aparte de `User` a propósito: `User` guarda solo lo de
/// acceso y seguridad. Sin fila, se usan los valores por defecto.
model UserPreferences {
  userId      String      @id @db.Uuid
  accentColor AccentColor @default(NEUTRO)
  fontScale   FontScale   @default(NORMAL)
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Un negocio registrado en la plataforma. Todo lo del negocio
/// (productos, ventas, clientes, proveedores…) le pertenece y el servidor
/// siempre filtra por el negocio de la sesión. El Encargado edita sus datos y
/// logo; el Administrador lo crea, define su plan y lo puede suspender.
model Business {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  /// Cédula jurídica o física del negocio.
  legalId        String?
  phone          String?
  email          String?
  address        String?
  /// Mensaje al pie del comprobante de venta.
  receiptMessage String?
  /// Logo (PNG, JPG o WEBP de hasta 1 MB).
  logoData       Bytes?
  logoMimeType   String?
  logoUpdatedAt  DateTime?
  /// Diseño de la etiqueta de productos (tamaño y qué datos lleva). `null` =
  /// diseño de fábrica. Lo valida `validators/label-design.validator.ts`.
  labelDesign    Json?
  /// Plan: el Encargado más estos usuarios adicionales (plan 0 = solo el
  /// Encargado). Solo lo cambia el Administrador, al crear el negocio o al
  /// aprobar una solicitud.
  extraUsers     Int            @default(0)
  status         BusinessStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  users             User[]
  planRequests      PlanRequest[]
  documentSequences DocumentSequence[]
  categories        Category[]
  products          Product[]
  customers         Customer[]
  sales             Sale[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  accessEvents      AccessEvent[]
}

/// Datos de la plataforma (una sola fila, `id = 1`): el nombre del sistema que
/// ven todos los negocios. Solo lo cambia el Administrador.
model PlatformSettings {
  id         Int      @id @default(1)
  systemName String   @default("MiniSuper")
  updatedAt  DateTime @updatedAt
}

/// Solicitud de un Encargado para ampliar su plan (más usuarios). Llega a la
/// bandeja del Administrador, que la aprueba o la rechaza.
model PlanRequest {
  id            String            @id @default(uuid()) @db.Uuid
  businessId    String            @db.Uuid
  requestedById String            @db.Uuid
  /// Cuántos usuarios adicionales pide (además de los que ya tiene).
  extraUsers    Int
  note          String?
  status        PlanRequestStatus @default(PENDING)
  /// Respuesta del Administrador (motivo del rechazo, por ejemplo).
  response      String?
  decidedById   String?           @db.Uuid
  decidedAt     DateTime?
  createdAt     DateTime          @default(now())

  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  requestedBy User     @relation("PlanRequestAuthor", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?    @relation("PlanRequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([businessId, createdAt])
}

/// Tipos de documento con consecutivo propio en cada negocio.
enum DocumentKind {
  SALE
  PURCHASE_ORDER
}

/// Contador de consecutivos POR NEGOCIO y tipo de documento (Venta #1, #2… de
/// cada negocio). Se toma con un `INSERT … ON CONFLICT DO UPDATE … RETURNING`
/// dentro de la misma transacción del documento: es atómico, no se repite y,
/// si el documento no se guarda, el número tampoco se gasta. Deja lista la base
/// para la factura electrónica, que exige un consecutivo por emisor.
model DocumentSequence {
  businessId String       @db.Uuid
  kind       DocumentKind
  /// Próximo número que se entregará.
  next       Int          @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, kind])
}

// -----------------------------------------------------------------------------
// Módulo 1 — Productos e inventario (HU-01 … HU-10)
// -----------------------------------------------------------------------------

/// Categoría de productos (HU-04).
model Category {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  /// Único dentro de cada negocio (dos negocios pueden tener «Lácteos»).
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([businessId, name])
  /// Para que un producto solo pueda usar categorías de su mismo negocio.
  @@unique([id, businessId])
}

/// Producto del catálogo (HU-01 … HU-09).
model Product {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @db.Uuid
  /// Código interno del producto, solicitado en HU-01. Único en el negocio.
  code           String
  /// Código de barras leído por el lector (HU-06). Puede no existir hasta
  /// generarlo con HU-07, por eso es opcional; único en el negocio.
  barcode        String?
  name           String
  description    String?
  /// Precio de venta al público (HU-01).
  price          Decimal       @db.Decimal(12, 2)
  /// Costo de referencia actual (HU-01). El costo por proveedor vive en
  /// SupplierProduct; este campo es el último costo conocido del producto.
  cost           Decimal       @db.Decimal(12, 2)
  /// Cantidad disponible. Todo cambio debe generar un InventoryMovement.
  stock          Int           @default(0)
  /// Mínimo que dispara la alerta de stock bajo (HU-08).
  minStock       Int           @default(0)
  /// Máximo que conviene tener (0 = sin máximo): la ficha avisa «Sobre el máximo».
  maxStock       Int           @default(0)
  /// En qué se cuenta el stock (UD, KG, L…).
  unit           UnitOfMeasure @default(UD)
  /// Solo aplica a productos perecederos (HU-09). Al cargar lotes con fecha
  /// (HU-38) pasa a ser la fecha del lote que vence primero.
  expirationDate DateTime?
  /// ¿Vence? Si es `true`, cada entrada pide lote Y fecha de vencimiento; si
  /// es `false` («No vence»: detergente, ollas) solo el lote, y si no se
  /// escribe, el lote es el número de factura (HU-38).
  perishable     Boolean       @default(true)
  /// Desactivar en lugar de eliminar: conserva el historial de ventas (HU-03).
  isActive       Boolean       @default(true)
  categoryId     String        @db.Uuid
  /// Imagen opcional del producto (HU-01). Se guarda en la base para que la app
  /// no dependa de una carpeta del servidor; el listado nunca la selecciona.
  imageData      Bytes?
  /// Tipo del archivo: solo image/png, image/jpeg o image/webp.
  imageMimeType  String?
  /// Cuándo cambió la imagen; va en la URL para que el navegador no muestre una vieja.
  imageUpdatedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business           Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Compuesta: la base impide usar una categoría de otro negocio.
  category           Category              @relation(fields: [categoryId, businessId], references: [id, businessId], onDelete: Restrict)
  supplierProducts   SupplierProduct[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  receiptItems       PurchaseReceiptItem[]
  lots               ProductLot[]

  @@unique([businessId, code])
  @@unique([businessId, barcode])
  @@index([categoryId])
}

/// Historial auditable de entradas, salidas y ajustes de inventario
/// (HU-10, HU-16). Responde "cuánto había, cuánto se movió, cuánto quedó".
model InventoryMovement {
  id              String                @id @default(uuid()) @db.Uuid
  productId       String                @db.Uuid
  type            InventoryMovementType
  /// Cantidad siempre positiva; el signo se interpreta según `type`.
  quantity        Int
  stockBefore     Int
  stockAfter      Int
  /// Motivo (conteo físico, devolución, merma, venta, recepción…).
  reason          String?
  /// Trazabilidad opcional hacia el documento que originó el movimiento.
  saleId          String?               @db.Uuid
  purchaseOrderId String?               @db.Uuid
  /// Recepción (factura) que cargó esta entrada (HU-38).
  receiptId       String?               @db.Uuid
  /// Documento de un ingreso o egreso registrado en Movimientos: la factura
  /// de una compra directa o el documento de un egreso (HU-38).
  documentNumber  String?
  /// Fecha del documento (la factura de una compra directa).
  documentDate    DateTime?             @db.Date
  /// Costo unitario de una compra directa.
  unitCost        Decimal?              @db.Decimal(12, 2)
  /// Proveedor de una compra directa (del mismo negocio: lo revisa el service).
  supplierId      String?               @db.Uuid
  /// Detalle libre de un egreso («botellas vencidas retiradas de la góndola»).
  detail          String?
  /// Lote del que salió un egreso registrado en Movimientos.
  exitLotId       String?               @db.Uuid
  createdAt       DateTime              @default(now())

  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  sale          Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  receipt       PurchaseReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  /// Lotes que entraron con este movimiento (HU-38); se ven por línea en el Kardex.
  lots          ProductLot[]     @relation("EntryLots")
  supplier      Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  exitLot       ProductLot?      @relation("ExitLot", fields: [exitLotId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([saleId])
  @@index([purchaseOrderId])
  @@index([receiptId])
  @@index([supplierId])
  @@index([exitLotId])
}

// -----------------------------------------------------------------------------
// Módulo 2 — Ventas, clientes y fiado (HU-16 … HU-20)
// -----------------------------------------------------------------------------

/// Cliente al que se le puede fiar (HU-18, HU-19) y cuyas deudas se reportan
/// (HU-30). Su saldo NO se almacena: se calcula como suma(ventas CREDIT) -
/// suma(abonos), por lo que nunca puede descuadrar con el historial.
model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  /// Un cliente con historial se desactiva, no se borra (integridad de ventas).
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sales          Sale[]
  creditPayments CreditPayment[]

  /// Para que una venta solo pueda fiarle a clientes de su mismo negocio.
  @@unique([id, businessId])
  @@index([businessId, name])
}

/// Venta registrada en caja (HU-16), con su método de pago (HU-17) o a crédito
/// / fiado (HU-18). El detalle de los productos vendidos vive en `SaleItem`.
model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @db.Uuid
  /// Consecutivo para las personas (Venta #12): va en el comprobante (HU-34) y
  /// en el historial (HU-20). Es POR NEGOCIO (cada uno empieza en 1): lo asigna
  /// `DocumentSequence` dentro de la transacción de la venta. Un contador global
  /// dejaba ver a cada negocio cuánto venden los demás.
  number         Int
  paymentMethod  PaymentMethod
  status         SaleStatus    @default(COMPLETED)
  /// Importe final de la venta: lo calcula el service sumando los ítems
  /// (HU-16: "el sistema calcula el total automáticamente"). Se guarda porque
  /// es el monto del comprobante y alimenta el historial del día (HU-20) y las
  /// ganancias (HU-29).
  total          Decimal       @db.Decimal(12, 2)
  notes          String?
  /// Obligatorio cuando paymentMethod = CREDIT (HU-18: "se asocia la venta a un
  /// cliente identificado"). La regla se aplica en el service con Zod, porque el
  /// SGDB no expresa dependencias entre columnas.
  customerId     String?       @db.Uuid
  /// Efectivo recibido (HU-17); solo en ventas CASH. El cambio no se guarda: se
  /// deriva como cashReceived - total, para que no pueda descuadrar.
  cashReceived   Decimal?      @db.Decimal(12, 2)
  /// Llave que genera la pantalla por cada intento de cobro. Al ser única (por
  /// negocio), un doble clic o un reintento de la misma confirmación no duplica
  /// la venta.
  idempotencyKey String?
  createdAt      DateTime      @default(now())

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Compuesta: la base impide fiarle a un cliente de otro negocio.
  customer           Customer?           @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  items              SaleItem[]
  adjustments        SaleAdjustment[]
  creditPayments     CreditPayment[]
  inventoryMovements InventoryMovement[]

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  /// HU-20: listar y totalizar las ventas del día (de cada negocio).
  @@index([businessId, createdAt])
  @@index([createdAt])
  @@index([customerId])
  @@index([paymentMethod, createdAt])
}

/// Línea de detalle de una venta (HU-16). Guarda el precio y el costo unitarios
/// vigentes al momento de vender, para que el reporte de ganancias (HU-29) no
/// cambie si el precio o el costo del producto se modifican después (HU-02).
model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  /// Precio de venta aplicado en la línea.
  unitPrice Decimal @db.Decimal(12, 2)
  /// Costo unitario de referencia: base de la utilidad (HU-29).
  unitCost  Decimal @db.Decimal(12, 2)

  sale        Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  adjustments SaleAdjustmentItem[]

  @@index([saleId])
  @@index([productId])
}

/// Auditoría inmutable de una devolución parcial o anulación de venta (HU-35).
model SaleAdjustment {
  id        String             @id @default(uuid()) @db.Uuid
  saleId    String             @db.Uuid
  type      SaleAdjustmentType
  reason    String
  total     Decimal            @db.Decimal(12, 2)
  createdAt DateTime           @default(now())

  sale  Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items SaleAdjustmentItem[]

  @@index([saleId, createdAt])
}

/// Cantidades devueltas por línea; la cantidad vendida y su precio histórico no se modifican.
model SaleAdjustmentItem {
  id           String @id @default(uuid()) @db.Uuid
  adjustmentId String @db.Uuid
  saleItemId   String @db.Uuid
  quantity     Int

  adjustment SaleAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  saleItem   SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, saleItemId])
  @@index([saleItemId])
}

/// Abono a un fiado (HU-19: "se registra el monto pagado y la fecha").
/// Puede aplicarse a una venta concreta o ser un abono general que el service
/// distribuye sobre las ventas a crédito más antiguas del cliente.
model CreditPayment {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  saleId      String?  @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now())
  notes       String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([customerId, paymentDate])
  @@index([saleId])
}

// -----------------------------------------------------------------------------
// Módulo 3 — Proveedores y pedidos de compra (HU-21 … HU-24)
// -----------------------------------------------------------------------------
//
// Los reportes (HU-25 … HU-30) no necesitan entidades nuevas: se responden con
// consultas sobre las tablas de este esquema (stock/mínimos, vencimientos,
// ventas, ítems y abonos).

/// Proveedor del negocio y los productos que suministra (HU-21).
model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  /// Único dentro de cada negocio.
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business       Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]
  /// Compras directas registradas en Movimientos (HU-38).
  movements      InventoryMovement[]

  @@unique([businessId, name])
  /// Para que un pedido solo pueda ser a proveedores de su mismo negocio.
  @@unique([id, businessId])
}

/// Catálogo producto-proveedor (HU-21: "se puede asociar un proveedor a uno o
/// varios productos") con el costo al que se le compra. Alimenta el historial
/// de costos y compras por proveedor (HU-22) y la lista sugerida de pedido
/// (HU-23), donde `isPreferred` resuelve a cuál proveedor pedir cuando un
/// producto tiene varios.
model SupplierProduct {
  id          String   @id @default(uuid()) @db.Uuid
  supplierId  String   @db.Uuid
  productId   String   @db.Uuid
  unitCost    Decimal  @db.Decimal(12, 2)
  isPreferred Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
}

/// Pedido de compra a un proveedor (HU-22, HU-24). Al marcarlo como recibido se
/// generan las entradas de inventario y se actualiza el stock en la misma
/// transacción (HU-22: "historial de pedidos, costos y entregas").
model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  businessId   String              @db.Uuid
  /// Consecutivo para las personas (PED-0007): va en el papel que se entrega al
  /// proveedor y con él se buscará el pedido al registrar la entrada (HU-38).
  /// Es POR NEGOCIO; lo asigna `DocumentSequence` al crear el pedido.
  number       Int
  supplierId   String              @db.Uuid
  status       PurchaseOrderStatus @default(PENDING)
  /// Total del pedido (suma de cantidad * costo unitario de cada ítem): es el
  /// "costo" que muestra el historial (HU-22).
  total        Decimal             @default(0) @db.Decimal(12, 2)
  expectedDate DateTime?
  receivedAt   DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Compuesta: la base impide pedirle a un proveedor de otro negocio.
  supplier           Supplier            @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  items              PurchaseOrderItem[]
  receipts           PurchaseReceipt[]
  inventoryMovements InventoryMovement[]

  @@unique([businessId, number])
  @@index([businessId, createdAt])
  @@index([supplierId, createdAt])
  @@index([status])
}

/// Ítem de un pedido de compra. `receivedQuantity` permite recepciones
/// parciales sin necesidad de una entidad adicional.
model PurchaseOrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseOrderId  String  @db.Uuid
  productId        String  @db.Uuid
  quantity         Int
  unitCost         Decimal @db.Decimal(12, 2)
  receivedQuantity Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
}

/// Una entrega del proveedor contra un pedido (HU-38), con su factura. Un pedido
/// puede recibirse en varias entregas (factura #1, #2…) y cada una guarda la
/// fecha REAL en que llegó y la cantidad real de cada producto.
///
/// Registrar la entrega y cargarla al inventario son dos pasos: la carga puede
/// hacerse al registrarla o quedar pendiente (`loadedAt` nulo) hasta que alguien
/// la confirme. Lo confirmado no se edita.
model PurchaseReceipt {
  id              String    @id @default(uuid()) @db.Uuid
  purchaseOrderId String    @db.Uuid
  /// Número de la factura del proveedor; no se repite dentro del pedido.
  invoiceNumber   String
  /// Día en que llegó la mercadería (no el día en que se registró).
  receivedOn      DateTime  @db.Date
  /// Cuándo se cargó al inventario; nulo = carga pendiente.
  loadedAt        DateTime?
  /// Factura del proveedor escaneada o en PDF (hasta 5 MB). Se puede adjuntar al
  /// registrar la entrega o después; la lista nunca selecciona los bytes.
  invoiceFileData Bytes?
  /// Solo application/pdf, image/png, image/jpeg o image/webp.
  invoiceFileType String?
  /// Nombre del archivo como lo subió la persona (para descargarlo igual).
  invoiceFileName String?
  invoiceFileAt   DateTime?
  createdAt       DateTime  @default(now())

  purchaseOrder      PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  items              PurchaseReceiptItem[]
  inventoryMovements InventoryMovement[]

  @@unique([purchaseOrderId, invoiceNumber])
  @@index([purchaseOrderId, createdAt])
  @@index([loadedAt])
}

/// Cuánto llegó de un producto en una entrega.
model PurchaseReceiptItem {
  id        String @id @default(uuid()) @db.Uuid
  receiptId String @db.Uuid
  productId String @db.Uuid
  quantity  Int

  receipt PurchaseReceipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Cómo vino partido en lotes; la suma de los lotes es `quantity`.
  lots    PurchaseReceiptItemLot[]

  @@unique([receiptId, productId])
  @@index([productId])
}

/// Un lote de lo que llegó de un producto en una entrega (HU-38): su número,
/// su fecha de vencimiento (nula si el producto no vence) y cuántas unidades.
/// Se guarda al registrar la entrega y pasa a `ProductLot` al cargarla.
model PurchaseReceiptItemLot {
  id             String    @id @default(uuid()) @db.Uuid
  receiptItemId  String    @db.Uuid
  lotNumber      String
  expirationDate DateTime? @db.Date
  quantity       Int

  receiptItem PurchaseReceiptItem @relation(fields: [receiptItemId], references: [id], onDelete: Cascade)

  @@unique([receiptItemId, lotNumber])
}

/// Lote en inventario (HU-38, HU-32): cuántas unidades quedan de cada lote y
/// cuándo vence. Un lote nuevo NUNCA reemplaza la fecha de los anteriores.
///
/// La base mantiene siempre `Product.stock` = suma de `quantity` de sus lotes:
/// un disparador (migración `20261110120000_lotes_vencimiento`) descuenta del
/// lote que vence primero cuando el stock baja (venta, conteo, edición) y
/// guarda como «SIN LOTE» lo que sube sin lote (devolución, conteo). Así
/// ningún módulo tiene que acordarse de los lotes para no descuadrarlos.
model ProductLot {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @db.Uuid
  lotNumber        String
  /// Nula si el producto no vence.
  expirationDate   DateTime? @db.Date
  /// Unidades que quedan; nunca negativo (CHECK en la migración).
  quantity         Int
  /// Unidades con que entró el lote.
  receivedQuantity Int
  /// Entrada del Kardex que trajo el lote (nula en los lotes «SIN LOTE»).
  entryMovementId  String?   @db.Uuid
  createdAt        DateTime  @default(now())

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  entryMovement InventoryMovement?  @relation("EntryLots", fields: [entryMovementId], references: [id], onDelete: SetNull)
  exitMovements InventoryMovement[] @relation("ExitLot")

  @@index([productId, expirationDate])
  @@index([entryMovementId])
}

/// Registro de seguridad de las cuentas (HU-13): a quién se le cambió o
/// restableció la contraseña, quién lo hizo y cuándo. Si algo raro pasa, queda
/// la evidencia. Nunca guarda contraseñas ni enlaces. Solo se agregan filas.
model AccessEvent {
  id         String          @id @default(uuid()) @db.Uuid
  /// Negocio de la cuenta afectada; `null` si es un administrador de la plataforma.
  businessId String?         @db.Uuid
  /// Cuenta a la que se le cambió la contraseña.
  userId     String          @db.Uuid
  /// Quién lo hizo, si fue otra persona (un Encargado o un Administrador).
  actorId    String?         @db.Uuid
  type       AccessEventType
  createdAt  DateTime        @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User      @relation("AccessEventUser", fields: [userId], references: [id], onDelete: Restrict)
  actor    User?     @relation("AccessEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
}

/// Qué pasó con la contraseña.
enum AccessEventType {
  /// La persona la recuperó con el enlace de su correo.
  PASSWORD_RECOVERED_BY_EMAIL
  /// Su Encargado o un Administrador le puso una temporal.
  PASSWORD_RESET_BY_MANAGER
  /// La persona la cambió en «Mi perfil».
  PASSWORD_CHANGED
}
