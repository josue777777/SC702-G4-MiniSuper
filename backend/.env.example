# ---------------------------------------------------------------------------
# backend/.env.example — copia este archivo como "backend/.env" y ajusta
# ---------------------------------------------------------------------------
# Prisma 7 NO carga .env automáticamente: quien lo carga es
# backend/prisma7.config.ts (importa "dotenv/config"), y el backend lo carga en
# src/config/env.ts. Ambas lecturas usan este mismo archivo.

# --- Servidor HTTP -----------------------------------------------------------
PORT=4000
# development | test | production
NODE_ENV=development

# --- CORS --------------------------------------------------------------------
# Origen del frontend que puede llamar a la API (Vite usa 5173)
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL --------------------------------------------------------------
# Con la base en Docker (docker compose up -d) estos valores funcionan tal cual.
# La cadena debe empezar con postgresql:// (Prisma no acepta "postgres://").
DATABASE_URL=postgresql://minisuper:minisuper@localhost:5432/minisuper?schema=public

# --- Cuenta del dueño y sesión (HU-12, HU-14) ----------------------------------
# Clave para firmar la sesión (mínimo 32 caracteres, al azar). OBLIGATORIA en
# producción. En desarrollo se puede omitir: se genera una por arranque y las
# sesiones se cierran al reiniciar el servidor. Genere una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Token de un solo uso para la configuración inicial del dueño (HU-12; mínimo 16
# caracteres). OBLIGATORIO en producción: sin él la pantalla /setup queda
# deshabilitada, así nadie ajeno puede adueñarse de una instalación recién
# publicada. Defínalo solo en el servidor, nunca en el repositorio. Si se define en
# desarrollo, el formulario /setup también lo pedirá.
# SETUP_TOKEN=
